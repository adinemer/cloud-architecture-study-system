{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adinemer/cloud-architecture-study-system/schemas/session-v1.schema.json",
  "title": "Controlled Study Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id","schema_version","certification","exam_scope_version","unit_ids","objective_ids","session_type","status","control_snapshot","authorities_consulted","sources","prerequisite_sessions","required_artifact_types","planned_activity","exit_criteria","activities_completed","artifacts","evidence","misconceptions","mastery_changes","unresolved_items","next_permitted_action","completion_qa"],
  "properties": {
    "session_id": {"type":"string","pattern":"^SAP-C02-U[0-9]{2}-S[0-9]{3}$"},
    "schema_version": {"const":"1.0.0"},
    "certification": {"const":"SAP-C02"},
    "exam_scope_version": {"type":"string","minLength":1},
    "unit_ids": {"type":"array","items":{"type":"string","pattern":"^U[0-9]{2}$"},"minItems":1,"uniqueItems":true},
    "objective_ids": {"type":"array","items":{"type":"string","pattern":"^[1-4]\\.[1-6]$"},"uniqueItems":true},
    "session_type": {"enum":["SCOPE_BASELINE","READING","EXTRACTION_REVIEW","INSTRUCTION_DISCUSSION","ARCHITECTURE_DECISION","LAB","ASSESSMENT","REMEDIATION","CAPSTONE","READINESS_REVIEW"]},
    "status": {"enum":["PLANNED","READY","ACTIVE","PAUSED","REVIEW_PENDING","COMPLETED","ARCHIVED","BLOCKED","ABORTED","SUPERSEDED"]},
    "control_snapshot": {
      "type":"object","additionalProperties":false,
      "required":["snapshot_id","repository_commit_sha","created_at","governance_hashes","objective_map_hash","artifact_schema_version","session_schema_version","prompt_versions","project_state_version","mastery_state_version"],
      "properties": {
        "snapshot_id":{"type":"string","minLength":1},
        "repository_commit_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
        "created_at":{"type":"string","format":"date-time"},
        "governance_hashes":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
        "objective_map_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "artifact_schema_version":{"type":"string","minLength":1},
        "session_schema_version":{"const":"1.0.0"},
        "prompt_versions":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
        "project_state_version":{"type":"string","minLength":1},
        "mastery_state_version":{"type":"string","minLength":1}
      }
    },
    "authorities_consulted":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
    "sources":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "prerequisite_sessions":{"type":"array","items":{"type":"string","pattern":"^SAP-C02-U[0-9]{2}-S[0-9]{3}$"},"uniqueItems":true},
    "required_artifact_types":{"type":"array","items":{"enum":["source_summary","architecture_note","decision_record","comparison_matrix","pattern_note","flashcard_set","lab_brief","assessment_set","misconception_record"]},"uniqueItems":true},
    "planned_activity":{"type":"string","minLength":1},
    "exit_criteria":{"type":"array","items":{"type":"string","minLength":1},"minItems":1},
    "started_at":{"type":["string","null"],"format":"date-time"},
    "ended_at":{"type":["string","null"],"format":"date-time"},
    "elapsed_minutes":{"type":["integer","null"],"minimum":0},
    "human_reading_minutes":{"type":["integer","null"],"minimum":0},
    "activities_completed":{"type":"array","items":{"type":"string","minLength":1}},
    "artifacts":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "evidence":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "misconceptions":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "mastery_changes":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "unresolved_items":{"type":"array","items":{"type":"string","minLength":1}},
    "next_permitted_action":{"type":["string","null"]},
    "completion_qa":{"enum":["NOT_RUN","PASS","FAIL","BLOCKED"]},
    "pause_state":{"type":["object","null"],"additionalProperties":true},
    "exception_reason":{"type":["string","null"]},
    "supersedes_session_id":{"type":["string","null"],"pattern":"^SAP-C02-U[0-9]{2}-S[0-9]{3}$"}
  }
}
