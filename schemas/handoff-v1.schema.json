{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/adinemer/cloud-architecture-study-system/schemas/handoff-v1.schema.json",
  "title":"Controlled Study Session Handoff v1",
  "type":"object",
  "additionalProperties":false,
  "required":["handoff_id","schema_version","source_session_id","source_chat_title","source_status","created_at","completed_purpose","objective_ids","sources_used","artifact_ids","evidence_ids","mastery_changes","active_misconceptions","unresolved_items","decisions_and_mental_models","pending_qa","lab_cleanup_obligations","deferred_questions","next_session_status","target_session_id","next_recommended_purpose","next_prerequisites","required_reload_authorities","do_not_infer","continuity_notes","source_control_snapshot_id"],
  "properties": {
    "handoff_id":{"type":"string","pattern":"^HO-SAP-C02-U[0-9]{2}-S[0-9]{3}-[0-9]{3}$"},
    "schema_version":{"const":"1.0.0"},
    "source_session_id":{"type":"string","pattern":"^SAP-C02-U[0-9]{2}-S[0-9]{3}$"},
    "source_chat_title":{"type":"string","minLength":1},
    "source_status":{"enum":["COMPLETED","ABORTED","SUPERSEDED","PAUSED"]},
    "created_at":{"type":"string","format":"date-time"},
    "completed_purpose":{"type":"string","minLength":1},
    "objective_ids":{"type":"array","items":{"type":"string","pattern":"^[1-4]\\.[1-6]$"},"uniqueItems":true},
    "sources_used":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "artifact_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "evidence_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "mastery_changes":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "active_misconceptions":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "unresolved_items":{"type":"array","items":{"type":"string","minLength":1}},
    "decisions_and_mental_models":{"type":"array","items":{"type":"string","minLength":1}},
    "pending_qa":{"type":"array","items":{"type":"string","minLength":1}},
    "lab_cleanup_obligations":{"type":"array","items":{"type":"string","minLength":1}},
    "deferred_questions":{"type":"array","items":{"type":"string","minLength":1}},
    "next_session_status":{"enum":["TARGET_SELECTED","NEXT_SESSION_PENDING_COORDINATOR_SELECTION","NO_FURTHER_SESSION_REQUIRED"]},
    "target_session_id":{"type":["string","null"],"pattern":"^SAP-C02-U[0-9]{2}-S[0-9]{3}$"},
    "next_recommended_purpose":{"type":"string","minLength":1},
    "next_prerequisites":{"type":"array","items":{"type":"string","minLength":1}},
    "required_reload_authorities":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "do_not_infer":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "continuity_notes":{"type":"array","items":{"type":"string","minLength":1}},
    "source_control_snapshot_id":{"type":"string","minLength":1}
  }
}
