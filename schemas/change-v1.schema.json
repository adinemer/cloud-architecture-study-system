{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/adinemer/cloud-architecture-study-system/schemas/change-v1.schema.json",
  "title":"Governed Study System Change v1",
  "type":"object","additionalProperties":false,
  "required":["change_id","schema_version","change_class","timestamp","initiator","reason","affected_items","required_qa","approval_status","effective_at"],
  "properties":{
    "change_id":{"type":"string","pattern":"^CHG-[0-9]{4}-[0-9]{3}$"},
    "schema_version":{"const":"1.0.0"},
    "change_class":{"enum":["C0","C1","C2","C3","C4","C5"]},
    "timestamp":{"type":"string","format":"date-time"},
    "initiator":{"type":"string","minLength":1},
    "reason":{"type":"string","minLength":1},
    "old_version_or_hash":{"type":["string","null"]},
    "new_version_or_hash":{"type":["string","null"]},
    "affected_items":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
    "affected_units":{"type":"array","items":{"type":"string","pattern":"^U[0-9]{2}$"},"uniqueItems":true},
    "affected_objectives":{"type":"array","items":{"type":"string","pattern":"^[1-4]\\.[1-6]$"},"uniqueItems":true},
    "affected_artifacts":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "affected_sessions":{"type":"array","items":{"type":"string","pattern":"^SAP-C02-U[0-9]{2}-S[0-9]{3}$"},"uniqueItems":true},
    "required_qa":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "migration_actions":{"type":"array","items":{"type":"string","minLength":1}},
    "approval_status":{"enum":["PROPOSED","QA_PENDING","APPROVED","REJECTED","SUPERSEDED"]},
    "approved_by":{"type":["string","null"]},
    "effective_at":{"type":["string","null"],"format":"date-time"}
  }
}
