{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/adinemer/cloud-architecture-study-system/schemas/state-v1.schema.json",
  "title":"Cloud Study State v1",
  "oneOf":[{"$ref":"#/$defs/projectState"},{"$ref":"#/$defs/masteryState"}],
  "$defs":{
    "projectState":{
      "type":"object","additionalProperties":false,
      "required":["state_type","schema_version","state_version","certification","exam_scope_version","study_status","current_unit","active_session_id","last_completed_session_id","next_permitted_action","control_gate_status","updated_at"],
      "properties":{
        "state_type":{"const":"PROJECT_STATE"},
        "schema_version":{"const":"1.0.0"},
        "state_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "certification":{"const":"SAP-C02"},
        "exam_scope_version":{"type":"string","minLength":1},
        "study_status":{"enum":["NOT_STARTED","READY_FOR_DRY_RUN","READY_TO_START","IN_PROGRESS","PAUSED","COMPLETED","BLOCKED"]},
        "current_unit":{"type":["string","null"],"pattern":"^U[0-9]{2}$"},
        "active_session_id":{"type":["string","null"],"pattern":"^SAP-C02-U[0-9]{2}-S[0-9]{3}$"},
        "last_completed_session_id":{"type":["string","null"],"pattern":"^SAP-C02-U[0-9]{2}-S[0-9]{3}$"},
        "next_permitted_action":{"type":"string","minLength":1},
        "control_gate_status":{"type":"object","additionalProperties":{"enum":["PASS","PENDING","BLOCKED","NOT_REQUIRED"]},"minProperties":1},
        "updated_at":{"type":"string","format":"date-time"}
      }
    },
    "score":{"oneOf":[{"type":"integer","minimum":0,"maximum":5},{"const":"NOT_APPLICABLE"}]},
    "masteryEntry":{
      "type":"object","additionalProperties":false,
      "required":["E","A","H","confidence","status","evidence_ids","updated_at"],
      "properties":{
        "E":{"$ref":"#/$defs/score"},
        "A":{"$ref":"#/$defs/score"},
        "H":{"$ref":"#/$defs/score"},
        "confidence":{"enum":["LOW","MEDIUM","HIGH"]},
        "status":{"enum":["UNASSESSED","IN_PROGRESS","REVIEW_REQUIRED","COMPLETE","BLOCKED"]},
        "evidence_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
        "active_misconception_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
        "updated_at":{"type":"string","format":"date-time"}
      }
    },
    "historyEntry":{
      "type":"object","additionalProperties":false,
      "required":["change_id","target","dimension","previous_value","new_value","evidence_ids","session_id","timestamp","reason","control_snapshot_id"],
      "properties":{
        "change_id":{"type":"string","minLength":1},
        "target":{"type":"string","minLength":1},
        "dimension":{"enum":["E","A","H","STATUS","CONFIDENCE"]},
        "previous_value":{},
        "new_value":{},
        "evidence_ids":{"type":"array","items":{"type":"string","minLength":1}},
        "session_id":{"type":"string","pattern":"^SAP-C02-U[0-9]{2}-S[0-9]{3}$"},
        "timestamp":{"type":"string","format":"date-time"},
        "reason":{"type":"string","minLength":1},
        "control_snapshot_id":{"type":"string","minLength":1}
      }
    },
    "masteryState":{
      "type":"object","additionalProperties":false,
      "required":["state_type","schema_version","state_version","certification","exam_scope_version","units","objectives","history","updated_at"],
      "properties":{
        "state_type":{"const":"MASTERY_STATE"},
        "schema_version":{"const":"1.0.0"},
        "state_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "certification":{"const":"SAP-C02"},
        "exam_scope_version":{"type":"string","minLength":1},
        "units":{"type":"object","patternProperties":{"^U[0-9]{2}$":{"$ref":"#/$defs/masteryEntry"}},"additionalProperties":false},
        "objectives":{"type":"object","patternProperties":{"^[1-4]\\.[1-6]$":{"$ref":"#/$defs/masteryEntry"}},"additionalProperties":false},
        "history":{"type":"array","items":{"$ref":"#/$defs/historyEntry"}},
        "updated_at":{"type":"string","format":"date-time"}
      }
    }
  }
}
