{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adinemer/cloud-architecture-study-system/schemas/chat-session-v1.schema.json",
  "title": "Controlled ChatGPT Study Chat v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id", "schema_version", "chat_title", "purpose", "primary_session_type",
    "allowed_scope", "out_of_scope", "startup_repository_snapshot_id", "status",
    "opened_at", "closed_at", "handoff_required", "handoff_target_session_id", "resume_anchor"
  ],
  "properties": {
    "session_id": {"type":"string","pattern":"^SAP-C02-U[0-9]{2}-S[0-9]{3}$"},
    "schema_version": {"const":"1.1.0"},
    "chat_title": {"type":"string","minLength":1},
    "purpose": {"type":"string","minLength":1},
    "primary_session_type": {"enum":["SCOPE_BASELINE","READING","EXTRACTION_REVIEW","INSTRUCTION_DISCUSSION","ARCHITECTURE_DECISION","LAB","ASSESSMENT","REMEDIATION","CAPSTONE","READINESS_REVIEW"]},
    "allowed_scope": {"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
    "out_of_scope": {"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
    "startup_repository_snapshot_id": {"type":"string","minLength":1},
    "status": {"enum":["PLANNED","OPEN","PAUSED","CLOSED","SUPERSEDED"]},
    "opened_at": {"type":["string","null"],"format":"date-time"},
    "closed_at": {"type":["string","null"],"format":"date-time"},
    "handoff_required": {"const":true},
    "handoff_target_session_id": {"type":["string","null"],"pattern":"^SAP-C02-U[0-9]{2}-S[0-9]{3}$"},
    "resume_anchor": {
      "type":["object","null"],
      "additionalProperties":false,
      "properties": {
        "last_completed_activity":{"type":"string"},
        "next_activity":{"type":"string"},
        "source_locator":{"type":["string","null"]},
        "current_question_or_decision":{"type":["string","null"]},
        "pending_artifact_or_qa":{"type":["string","null"]},
        "unresolved_item":{"type":["string","null"]}
      }
    }
  }
}
